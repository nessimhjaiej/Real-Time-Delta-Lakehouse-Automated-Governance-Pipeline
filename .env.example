# Copy this file to .env and fill in real values. .env is gitignored; this
# file is not, so never put a real key in .env.example.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# LangSmith tracing (optional). Leave tracing false unless you have a key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=realtime-governance-engine
